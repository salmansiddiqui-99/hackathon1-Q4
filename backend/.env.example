# Physical AI Textbook Backend - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# Server Configuration
# ============================================================================
HOST=127.0.0.1
PORT=8000
DEBUG=true
LOG_LEVEL=info

# ============================================================================
# OpenAI API Configuration
# ============================================================================
OPENAI_API_KEY=sk-...  # Your OpenAI API key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4

# ============================================================================
# Qdrant Vector Store Configuration
# ============================================================================
QDRANT_URL=https://YOUR_CLUSTER.qdrant.io  # Qdrant Cloud endpoint
QDRANT_API_KEY=your-api-key                # Qdrant API key
QDRANT_COLLECTION=chapter_chunks            # Collection name

# ============================================================================
# PostgreSQL Database Configuration (Optional)
# ============================================================================
# Leave empty to use SQLite for development
DATABASE_URL=postgresql://user:password@localhost:5432/physical_ai_book
# DATABASE_URL=sqlite:///./test.db  # SQLite for development

# ============================================================================
# Claude Code / Subagent Configuration
# ============================================================================
CLAUDE_API_KEY=sk-ant-...  # Your Claude API key (if using Claude subagents)
CLAUDE_MODEL=claude-opus-4-5-20251101

# ============================================================================
# GitHub Configuration (for deployment)
# ============================================================================
GITHUB_OWNER=yourname
GITHUB_REPO=physical_ai_book
GITHUB_TOKEN=ghp_...  # GitHub Personal Access Token (optional)

# ============================================================================
# Application Secrets (Change in production)
# ============================================================================
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256

# ============================================================================
# Neon Database Configuration (Optional)
# ============================================================================
NEON_CONNECTION_STRING=postgresql://user:password@ep-XXXXX.us-east-1.neon.tech/neondb

# ============================================================================
# Feature Flags
# ============================================================================
ENABLE_RAG_CHATBOT=true
ENABLE_CHAPTER_GENERATION=true
ENABLE_ANALYTICS=false
ENABLE_LOGGING_TO_DB=false

# ============================================================================
# Performance & Limits
# ============================================================================
MAX_CHUNK_SIZE=1000
EMBEDDING_BATCH_SIZE=100
VECTOR_SEARCH_TOP_K=5
SIMILARITY_THRESHOLD=0.75
GENERATION_TIMEOUT_SECONDS=300

# ============================================================================
# CORS Configuration
# ============================================================================
CORS_ORIGINS=http://localhost:3000,https://yourname.github.io
