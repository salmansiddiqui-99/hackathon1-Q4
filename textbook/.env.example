# Frontend Environment Configuration
# Note: Frontend should NOT contain any API keys (only backend endpoints)

# ============================================================================
# 🔗 BACKEND API ENDPOINTS
# ============================================================================
# These must match the backend deployment URL

# Development environment
# VITE_API_BASE_URL=http://localhost:8000
# VITE_HEALTH_CHECK_ENDPOINT=http://localhost:8000/api/ready
# VITE_CHATBOT_QUERY_ENDPOINT=http://localhost:8000/api/chatbot/query

# Production environment (GitHub Pages + Railway)
# VITE_API_BASE_URL=https://hackathon1-q4-production.up.railway.app
# VITE_HEALTH_CHECK_ENDPOINT=https://hackathon1-q4-production.up.railway.app/api/ready
# VITE_CHATBOT_QUERY_ENDPOINT=https://hackathon1-q4-production.up.railway.app/api/chatbot/query

# ============================================================================
# ⚠️  SECURITY WARNING
# ============================================================================
# ❌ DO NOT add API keys, secrets, or tokens to this file
# ❌ DO NOT commit this file to GitHub (it's in .gitignore)
# ✅ All sensitive data should remain backend-only
# ✅ Environment detection is handled in textbook/static/js/api-url-config.js

# ============================================================================
# 🔧 BUILD CONFIGURATION (Optional)
# ============================================================================
# VITE_BUILD_TARGET=es2020
# VITE_DEBUG=false
